# Copy to .env and fill in. Never commit .env.

# MLflow tracking server and registry (DagsHub)
MLFLOW_TRACKING_URI=https://dagshub.com/iiDaVoDkA/MLOPS-PROJECT.mlflow
MLFLOW_TRACKING_USERNAME=
MLFLOW_TRACKING_PASSWORD=

# Model served by the app
MODEL_NAME=
MODEL_ALIAS=champion
PORT=8000
LOG_LEVEL=INFO

# Local monitoring stack (docker-compose.yml), all optional
GRAFANA_ADMIN_PASSWORD=
SMTP_ENABLED=false
SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=
ALERT_EMAIL=

# DVC remote on Azure Blob Storage: container-scoped SAS token
AZURE_STORAGE_SAS_TOKEN=
